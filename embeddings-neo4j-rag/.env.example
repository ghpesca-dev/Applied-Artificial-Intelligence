# OpenRouter (LLM used to generate the final answer)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME="Embeddings Neo4j RAG"
NLP_MODEL="nvidia/nemotron-3-super-120b-a12b:free"

# Local embedding model (Transformers.js, downloaded on first run)
EMBEDDING_MODEL='Xenova/all-MiniLM-L6-v2'

# Neo4j (matches docker-compose.yml)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
